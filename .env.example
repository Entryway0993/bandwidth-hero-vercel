# ==========================================
# VERCEL ENVIRONMENT VARIABLES
# ==========================================
# Add these to your Vercel Project Settings -> Environment Variables.

# --- Server & Logging ---
PORT=3000
LOG=1

# --- Client Authentication ---
# The key your browser extension or apps will use.
API_KEY=your_secure_api_key_here
LOGIN=
PASSWORD=

# --- Cloudflare Worker Integration ---
# The URL of your deployed Cloudflare Worker (e.g., https://your-worker.workers.dev)
CF_WORKER_URL=
# A secret key only Vercel and the Worker know. Used for the /raw back-channel.
INTERNAL_KEY=your_internal_key_here

# --- Network & Fetch Limits ---
UPSTREAM_ACCEPT_ENCODING=identity
MAX_DOWNLOAD_BYTES=20971520
REQUEST_TIMEOUT_MS=45000

# --- Compression Quality ---
DEFAULT_QUALITY=40
MIN_QUALITY=10
MAX_QUALITY=100

# --- AVIF / WebP Encoding Effort ---
# Lower = faster, Higher = smaller file size but more CPU.
AVIF_EFFORT_SMALL=4
AVIF_EFFORT_MEDIUM=3
AVIF_EFFORT_LARGE=2
WEBP_EFFORT=4

# --- Manga / Manhwa / Image Resizing ---
# Normal images max side cap. 0 disables.
MAX_OUTPUT_DIM=2560
# Long vertical strip width cap. 0 disables.
MAX_STRIP_WIDTH=1600
# true = grayscale by default, false = keep color.
DEFAULT_GRAYSCALE=false

# --- Text Sharpening ---
# off | resized | always
SHARPEN_MODE=resized
# 0.5 (subtle) to 2.0 (aggressive). 0.8 is best for comics.
SHARPEN_SIGMA=0.8


# ==========================================
# CLOUDFLARE WORKER ENVIRONMENT VARIABLES
# ==========================================
# Add these to your Cloudflare Worker Settings -> Variables and Secrets.

# The exact URL of your Vercel deployment (e.g., https://your-app.vercel.app)
VERCEL_URL=https://your-vercel-deployment.vercel.app

# The user-facing key. MUST match Vercel's API_KEY exactly.
USER_KEY=your_secure_api_key_here

# The back-channel key. MUST match Vercel's INTERNAL_KEY exactly.
INTERNAL_KEY=your_internal_key_here

# Optional: A dedicated key for the /purge route. 
# If left blank, the Worker will automatically fall back to using USER_KEY.
PURGE_KEY=
