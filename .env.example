# Server
PORT=3000
LOG=1
CORS_ORIGIN=*

# Auth (at least one required)
API_KEY=your_api_key_here
LOGIN=
PASSWORD=

# Legacy query auth (old/dumb clients)
ALLOW_QUERY_API_KEY=true

# Cloudflare Worker
CF_WORKER_URL=
INTERNAL_KEY=
PURGE_KEY=
USER_KEY=
VERCEL_URL=
VERCEL_SERVICE_KEY=

# Memory Governor (F2-ADAPTIVE)
MEMORY_CEILING_MB=1024
RSS_WALL_OFFSET_MB=25
RSS_ADMISSION_OFFSET_MB=60
PIXEL_MEMORY_DIVISOR=6

# Adaptive byte budgets (F4)
DOWNLOAD_BYTE_RATIO=0.35
DECOMPRESS_BYTE_RATIO=0.50

# Rate Limiting (F6)
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_FRONT_DOOR=300
RATE_LIMIT_MAX_AUTH_FAILURES=10
RATE_LIMIT_MAX_PURGE=10
RATE_LIMIT_MAX_RAW=120

# Mirror Racing (F7)
ENABLE_MIRROR_RACING=false

# Upstream allowlist (F7, optional)
UPSTREAM_ALLOWLIST=

# Upstream encoding
UPSTREAM_ACCEPT_ENCODING=identity

# Sharp
SHARP_CACHE_MEMORY_MB=350

# Output
MAX_OUTPUT_DIM=2560
DEFAULT_QUALITY=40
MAX_QUALITY=100
MIN_QUALITY=10
MAX_STRIP_WIDTH=1600
VIEWPORT_FALLBACK=1080

# Animation
MAX_ANIMATED_FRAMES=300

# Health
HEALTH_LAG_THRESHOLD=100
SHUTDOWN_TIMEOUT=10000

# Cache
CACHE_VERSION=1
