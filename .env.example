# ==========================================
# VERCEL / NODE.JS CONFIGURATION
# ==========================================

# Default is identity.
# If some origin absolutely requires gzip, you can set:
# UPSTREAM_ACCEPT_ENCODING=gzip
UPSTREAM_ACCEPT_ENCODING=identity

# Default is 20MB.
# If you want to reject anything above the 14MB compression threshold,
# set this closer to 15MB:
# MAX_DOWNLOAD_BYTES=15728640
MAX_DOWNLOAD_BYTES=20971520

REQUEST_TIMEOUT_MS=45000

# Server Port (Optional, defaults to 3000)
PORT=3000

# Enable Morgan Logging (1 = enabled, 0 = disabled)
LOG=1

# Basic Auth Credentials (Optional, if using Basic Auth)
LOGIN=
PASSWORD=

# API Key for Client Authentication (Required if not using Basic Auth)
API_KEY=your_secure_api_key_here

# Cloudflare Worker Back-channel URL (Optional)
CF_WORKER_URL=

# Internal Key for Vercel -> Cloudflare Worker Communication (Required if using CF_WORKER_URL)
INTERNAL_KEY=your_internal_key_here

# Compression Quality Defaults (Optional)
DEFAULT_QUALITY=40
MIN_QUALITY=10
MAX_QUALITY=100

AVIF_EFFORT_SMALL=4
AVIF_EFFORT_MEDIUM=3
AVIF_EFFORT_LARGE=2
WEBP_EFFORT=4

MAX_OUTPUT_DIM=2560
MAX_STRIP_WIDTH=1600
DEFAULT_GRAYSCALE=false

SHARPEN_MODE=resized
SHARPEN_SIGMA=0.8

# ==========================================
# CLOUDFLARE WORKER CONFIGURATION
# ==========================================

# Vercel Deployment URL (Required for Cloudflare Worker)
# VERCEL_URL=https://your-vercel-deployment.vercel.app

# User-facing API Key (Required for Cloudflare Worker)
# USER_KEY=your_secure_api_key_here

# Internal Key for Cloudflare Worker -> Vercel Communication (Required for Cloudflare Worker)
# INTERNAL_KEY=your_internal_key_here
