# ==========================================
# VERCEL ENVIRONMENT VARIABLES
# ==========================================

# --- Server & Logging ---
PORT=3000
LOG=1

# --- Client Authentication ---
API_KEY=your_secure_api_key_here
LOGIN=
PASSWORD=

# --- Cloudflare Worker Integration ---
CF_WORKER_URL=
INTERNAL_KEY=your_internal_key_here

# --- Network & Fetch Limits ---
UPSTREAM_ACCEPT_ENCODING=identity
# 🛑 ALIGNED: 12MB hard cap for 1GB RAM / 60s timeout safety.
MAX_DOWNLOAD_BYTES=12582912
REQUEST_TIMEOUT_MS=45000

# --- Memory-Weighted Concurrency (MAXIMIZED for 1GB RAM) ---
# Each 1MB of input buffer ≈ 1 slot. 40 slots ≈ 600MB safe working memory.
# Allows ~40 tiny images OR ~3 max-size images concurrently.
MAX_MEMORY_SLOTS=40
SLOT_BYTES=1048576

# --- Compression Quality ---
DEFAULT_QUALITY=40
MIN_QUALITY=10
MAX_QUALITY=100

# --- AVIF / WebP Encoding Effort ---
AVIF_EFFORT_SMALL=4
AVIF_EFFORT_MEDIUM=3
AVIF_EFFORT_LARGE=2
WEBP_EFFORT=4

# --- Manga / Manhwa / Image Resizing ---
MAX_OUTPUT_DIM=2560
MAX_STRIP_WIDTH=1600
DEFAULT_GRAYSCALE=false

# --- Text Sharpening ---
SHARPEN_MODE=resized
SHARPEN_SIGMA=0.8

# --- Animation Protection ---
MAX_ANIMATED_FRAMES=1000

# --- Format Compatibility ---
ALLOW_ACCEPT_FALLBACK=true

# --- MANDATORY PURGE KEY ---
PURGE_KEY=your_dedicated_purge_key_here

# --- Worker / Front-door Integration ---
USER_KEY=your_user_key_here
VERCEL_URL=https://your-vercel-app.vercel.app
CACHE_VERSION=1

# --- Sharp Memory ---
SHARP_CACHE_MEMORY_MB=700

# --- Performance Profile ---
# These reduce CPU and memory pressure heavily.
ENABLE_PLACEHOLDER=false
ENABLE_PALETTE=false
ENABLE_MOIRE=false
ENABLE_LINE_DENOISE=false
ENABLE_DESKEW=false
ENABLE_BANDING_EXORCIST=false
ENABLE_GHOST_STRIPPER=false
ENABLE_LAYOUT_PROPHET=false

# Keep these enabled for safety and core behavior.
ENABLE_TIMEOUT_GUILLOTINE=true
ENABLE_DIMENSION_OVERLORD=true
ENABLE_SEMAPHORE_WARDEN=true
ENABLE_ENCODING_VERIFIER=true
ENABLE_METADATA_REAPER=true
ENABLE_VOID_WATCHER=true
ENABLE_ALPHA_SENTINEL=true
